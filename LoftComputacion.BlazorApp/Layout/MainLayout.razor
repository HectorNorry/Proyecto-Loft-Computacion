@inherits LayoutComponentBase
@using MudBlazor
@using LoftComputacion.BlazorApp.Services.Auth
@using LoftComputacion.BlazorApp.Pages

@inject NavigationManager Nav
@inject CustomAuthStateProvider Auth
@inject IDialogService DialogService

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Color="Color.Primary" Elevation="4">
        <!-- Botón hamburguesa SOLO en pantallas chicas -->
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Edge="Edge.Start"
                       Color="Color.Inherit"
                       OnClick="@ToggleDrawer"
                       Class="mud-hidden-md-up" />

        <MudText Typo="Typo.h6" Class="ml-2">Panel LOFT</MudText>

        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       Color="Color.Inherit"
                       OnClick="Logout"
                       Title="Cerrar Sesión" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Never"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               Elevation="1"
               Width="260px">

        <div class="drawer-logo-container">
            <img src="images/Log.png" class="drawer-logo" />
        </div>

        <MudDivider Class="mb-2" />

        <MudNavMenu>
            <style>
                /* Estilos del menú */
                .mud-nav-link, .mud-list-item {
                    font-size: 1.1rem !important;
                    padding: 12px 16px !important;
                    margin-bottom: 4px;
                }

                    .mud-nav-link .mud-icon-root, .mud-list-item-icon {
                        font-size: 1.5rem !important;
                    }

                /* Logo del drawer */
                .drawer-logo-container {
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    padding: 16px 0;
                    overflow: hidden;
                }

                .drawer-logo {
                    max-width: 100%;
                    max-height: 56px;
                    object-fit: contain;
                }
            </style>

            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Inicio</MudNavLink>
            <MudNavLink Href="/ordenes" Icon="@Icons.Material.Filled.List">Órdenes</MudNavLink>
            <MudNavLink Href="/clientes" Icon="@Icons.Material.Filled.People">Clientes</MudNavLink>
            <MudNavLink Href="/metricas" Icon="@Icons.Material.Filled.BarChart">Métricas</MudNavLink>
            <MudNavLink Href="/administracion" Icon="@Icons.Material.Filled.Security">Administración</MudNavLink>
        </MudNavMenu>

        <MudList T="string" Clickable="true">
            <MudListItem OnClick="AbrirChat" Icon="@Icons.Material.Filled.SmartToy" Class="mt-2">
                Asistente IA
            </MudListItem>
        </MudList>

    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    // Drawer abierto en desktop por defecto
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void AbrirChat()
    {
        var options = new DialogOptions
        {
            Position = DialogPosition.Center,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            NoHeader = true,
            CloseOnEscapeKey = true
        };

        DialogService.Show<ChatAsistente>("", options);
    }

    private async Task Logout()
    {
        await Auth.MarkUserAsLoggedOut();
        Nav.NavigateTo("/login");
    }
}
