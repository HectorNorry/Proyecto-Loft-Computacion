@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>

        <MudThemeProvider />

        <!-- PROVEEDORES NECESARIOS -->
        <MudDialogProvider />
        <MudSnackbarProvider />
        <MudPopoverProvider />   @* ← FALTABA ESTE *@

        <MudLayout>

            <MudAppBar Color="Color.Primary" Elevation="4">
                <MudText Typo="Typo.h6">Panel LOFT</MudText>

                <MudSpacer />

                <MudIconButton Icon="@Icons.Material.Filled.Logout"
                               Color="Color.Inherit"
                               OnClick="Logout" />
            </MudAppBar>


            <MudDrawer Open="true"
                       ClipMode="DrawerClipMode.Never"
                       Variant="DrawerVariant.Mini">


                <MudNavMenu>
                    <div class="d-flex justify-center pa-4">
                        <img src="/images/Log.png" style="width:120px;" />
                    </div>
                    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">
                        Inicio
                    </MudNavLink>

                    <MudNavLink Href="/ordenes" Icon="@Icons.Material.Filled.List">
                        Órdenes
                    </MudNavLink>

                    <MudNavLink Href="/clientes" Icon="@Icons.Material.Filled.People">
                        Clientes
                    </MudNavLink>

                    <MudNavLink Href="/usuarios" Icon="@Icons.Material.Filled.Person">
                        Usuarios
                    </MudNavLink>

                    <MudNavLink Href="/ganancias" Icon="@Icons.Material.Filled.AttachMoney">
                        Ganancias
                    </MudNavLink>

                </MudNavMenu>

            </MudDrawer>

            <MudMainContent>
                @Body
            </MudMainContent>

        </MudLayout>
    </Authorized>

    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject] CustomAuthStateProvider Auth { get; set; }
    [Inject] NavigationManager Nav { get; set; }

    private async Task Logout()
    {
        await Auth.MarkUserAsLoggedOut();
        Nav.NavigateTo("/login", true);
    }
}
