@inherits LayoutComponentBase

@* --- USINGS E INJECTS --- *@
@using Microsoft.AspNetCore.Components.Authorization
@using LoftComputacion.BlazorApp.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<AuthorizeView Roles="Administrador">

    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4 d-flex justify-content-between align-items-center">
                    <h3 class="text-primary">Panel Administrador</h3>

                    @* 🔘 BOTÓN DE CERRAR SESIÓN *@
                    <button class="btn btn-outline-danger"
                            @onclick="CerrarSesion">
                        <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                    </button>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>

    <NotAuthorized>
        @{
            Navigation.NavigateTo("/login");
        }
    </NotAuthorized>

</AuthorizeView>

<div id="blazor-error-ui">
    Ocurrió un error inesperado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            try
            {
                await ((CustomAuthStateProvider)AuthStateProvider).InitializeAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al inicializar AuthState: {ex.Message}");
                Navigation.NavigateTo("/login");
            }
        }
    }

    private async Task CerrarSesion()
    {
        if (AuthStateProvider is CustomAuthStateProvider customProvider)
        {
            await customProvider.LogoutAsync(); // limpia token y notifica
        }

        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
