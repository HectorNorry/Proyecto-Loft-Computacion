@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components.Authorization
@using LoftComputacion.BlazorApp.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<AuthorizeView Roles="Administrador">
    <Authorized>
        <div class="d-flex flex-column flex-md-row min-vh-100">

            <!-- Sidebar -->
            <aside class="bg-dark text-white p-2 flex-shrink-0" style="min-width:220px;">
                <NavMenu />
            </aside>

            <!-- Main content -->
            <main class="page-main">
    <div class="top-row px-3 py-2 d-flex justify-content-between align-items-center border-bottom">
        <h3 class="text-primary mb-0">Panel Administrador</h3>

        <button class="btn btn-outline-danger btn-sm" @onclick="CerrarSesion">
            <i class="bi bi-box-arrow-right"></i> Cerrar sesión
        </button>
    </div>

    <article class="container-fluid py-3">
        @Body
    </article>
</main>
        </div>
    </Authorized>

    <NotAuthorized>
        @{
            Navigation.NavigateTo("/login");
        }
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" class="alert alert-danger alert-dismissible fade show position-fixed bottom-0 start-0 m-3" role="alert">
    Ocurrió un error inesperado.
    <a href="" class="reload alert-link">Recargar</a>
    <button type="button" class="btn-close dismiss" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

@code {
    private bool _initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            try
            {
                await ((CustomAuthStateProvider)AuthStateProvider).InitializeAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al inicializar AuthState: {ex.Message}");
                Navigation.NavigateTo("/login");
            }
        }
    }

    private async Task CerrarSesion()
    {
        if (AuthStateProvider is CustomAuthStateProvider customProvider)
        {
            await customProvider.LogoutAsync();
        }

        Navigation.NavigateTo("/login", forceLoad: true);
    }
}