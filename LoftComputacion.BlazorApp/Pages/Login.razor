@page "/login"
@layout LoginLayout

@using LoftComputacion.BlazorApp.Services.Auth
@inject AuthApiService AuthApi
@inject CustomAuthStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar


<MudPaper Class="pa-6" Elevation="4" Style="width:350px;margin:auto;margin-top:70px;">
    <div style="text-align:center; margin-bottom:20px;">
        <img src="images/Log.png"
             style="width:60%; max-width:220px;" />
    </div>
    <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4 fw-bold">
        Iniciar sesión
    </MudText>

    <MudTextField @bind-Value="_email"
                  Label="Usuario"
                  Required="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Person" />

    <MudTextField @bind-Value="_password"
                  Label="Contraseña"
                  Required="true"
                  InputType="InputType.Password"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Lock" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mt-4 w-100"
               OnClick="SubmitLogin">
        INGRESAR
    </MudButton>
</MudPaper>

@code {
    private string _email = "";
    private string _password = "";

    private async Task SubmitLogin()
    {
        Console.WriteLine(">>> SubmitLogin() ejecutado.");  // para probar

        try
        {
            var token = await AuthApi.LoginAsync(_email, _password);

            if (string.IsNullOrEmpty(token))
            {
                Snackbar.Add("Usuario o contraseña incorrectos.", Severity.Error);
                return;
            }

            await AuthState.MarkUserAsAuthenticated(token);

            Console.WriteLine(">>> Login exitoso, redirigiendo...");
            Nav.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al iniciar sesión.", Severity.Error);
            Console.WriteLine(">>> ERROR LOGIN: " + ex.Message);
        }
    }
}
