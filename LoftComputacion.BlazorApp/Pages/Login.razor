@page "/login"
@layout Layout.AnonymousLayout

@* --- USINGS E INJECTS (SE MANTIENEN IGUAL) --- *@
@using LoftComputacion.BlazorApp.DTOs
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@using LoftComputacion.BlazorApp.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Iniciar Sesión</PageTitle>

<div class="container-fluid min-vh-100 d-flex flex-column justify-content-center align-items-center bg-light">

    <!-- Logo -->
    <div class="text-center mb-3">
        <img src="img/logo.png" alt="Logo del Negocio" class="img-fluid" style="max-width: 220px; height: auto;">
    </div>

    <!-- Card de Login -->
    <div class="col-12 col-md-6 col-lg-4" style="max-width: 400px;">
        <div class="card shadow-lg">
            <div class="card-body p-4">
                <h4 class="card-title text-center mb-4 text-primary">Iniciar Sesión (Admin)</h4>

                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }

                    <!-- Usuario -->
                    <div class="mb-3">
                        <label for="username" class="form-label">Usuario</label>
                        <InputText id="username" class="form-control" @bind-Value="loginModel.NombreUsuario" />
                        <ValidationMessage For="@(() => loginModel.NombreUsuario)" />
                    </div>

                    <!-- Contraseña -->
                    <div class="mb-3">
                        <label for="password" class="form-label">Contraseña</label>
                        <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" />
                        <ValidationMessage For="@(() => loginModel.Password)" />
                    </div>

                    <!-- Botón -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span> Ingresando...</span>
                            }
                            else
                            {
                                <span>Ingresar</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new LoginModel();
    private string errorMessage;
    private bool isSubmitting = false;

    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var loginResponse = await response.Content.ReadFromJsonAsync<LoginResponseDto>();

                if (loginResponse != null && loginResponse.Rol.Equals("Administrador", StringComparison.OrdinalIgnoreCase))
                {
                    var token = loginResponse.Token;

                    var customAuthProvider = (CustomAuthStateProvider)AuthStateProvider;
                    await customAuthProvider.MarkUserAsAuthenticated(token);

                    await Task.Delay(300);
                    Navigation.NavigateTo("/");
                }
                else
                {
                    string rolRecibido = loginResponse?.Rol ?? "NULO";
                    errorMessage = $"Acceso denegado. Rol recibido: [{rolRecibido}]. Se requiere 'Administrador'.";
                }
            }
            else
            {
                errorMessage = "Usuario o contraseña incorrectos.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}