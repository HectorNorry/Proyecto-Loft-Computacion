@layout LoginLayout
@page "/restablecer-password/{Token}"
@using LoftComputacion.Shared.DTOs
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Class="pa-8 mx-auto" Elevation="3">
        <MudText Typo="Typo.h5" Class="mb-4 text-center">Nueva Contraseña</MudText>

        <MudTextField @bind-Value="Password" Label="Nueva Contraseña" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="ConfirmarPassword" Label="Confirmar Contraseña" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="CambiarClave" Disabled="@Enviando">
            Confirmar Cambio
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public string Token { get; set; }
    private string Password;
    private string ConfirmarPassword;
    private bool Enviando = false;

    private async Task CambiarClave()
    {
        if (string.IsNullOrWhiteSpace(Password)) { Snackbar.Add("Ingresá una contraseña.", Severity.Warning); return; }
        if (Password != ConfirmarPassword) { Snackbar.Add("Las contraseñas no coinciden.", Severity.Error); return; }

        Enviando = true;
        try
        {
            var dto = new RestablecerPasswordDto { Token = Token, NuevaPassword = Password };
            var response = await Http.PostAsJsonAsync("api/Auth/restablecer-password", dto);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("¡Contraseña actualizada! Iniciá sesión.", Severity.Success);
                await Task.Delay(2000);
                Nav.NavigateTo("/login");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {error}", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Error al intentar cambiar la clave.", Severity.Error);
        }
        finally { Enviando = false; }
    }
}