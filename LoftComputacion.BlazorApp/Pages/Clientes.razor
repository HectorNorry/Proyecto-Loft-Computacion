@page "/clientes"

@* --- 1. Imports y Seguridad --- *@
@using LoftComputacion.Domain
@using LoftComputacion.BlazorApp.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject ClientesApiService ApiService

<PageTitle>Clientes Registrados</PageTitle>

<div class="container-fluid py-3">
    <h4 class="text-primary mb-4">Clientes Registrados</h4>

    @if (clientes == null)
    {
        <div class="alert alert-info">
            <em>Cargando clientes...</em>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-success">
                    <tr>
                        <th scope="col">N° Cliente</th>
                        <th scope="col">Nombre Completo</th>
                        <th scope="col">DNI</th>
                        <th scope="col">Teléfono</th>
                        <th scope="col">Email</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in clientes)
                    {
                        <tr>
                            <td>@cliente.Id</td>
                            <td>@cliente.NombreCompleto</td>
                            <td>@cliente.DNI</td>
                            <td>@cliente.Telefono</td>
                            <td>@cliente.Email</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Cliente>? clientes;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes = await ApiService.GetClientesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar clientes: {ex.Message}");
        }
    }
}