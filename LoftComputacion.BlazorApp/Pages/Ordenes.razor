@page "/ordenes"

@* --- 1. Imports y Seguridad --- *@
@using LoftComputacion.BlazorApp.DTOs
@using LoftComputacion.BlazorApp.Services
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@attribute [Authorize(Roles = "Administrador")]

@* 2. Inyección del servicio *@
@inject OrdenesApiService ApiService

<PageTitle>Órdenes de Servicio</PageTitle>

<div class="container-fluid py-3">
    <h4 class="text-primary mb-4">Órdenes de Servicio</h4>

    @if (ordenes == null)
    {
        <div class="alert alert-info">
            <em>Cargando órdenes...</em>
        </div>
    }
    else if (!ordenes.Any())
    {
        <div class="alert alert-warning">
            No se encontraron órdenes de servicio registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>ID</th>
                        <th>Fecha Ingreso</th>
                        <th>Cliente</th>
                        <th>Equipo</th>
                        <th>Falla Declarada</th>
                        <th>Estado</th>
                        <th class="text-end">Precio Final</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var orden in ordenes)
                    {
                        <tr>
                            <td>@orden.Id</td>
                            <td>@orden.FechaIngreso.ToShortDateString()</td>
                            <td>@orden.NombreCliente</td>
                            <td>@orden.ModeloEquipo</td>
                            <td>@orden.FallaDeclaradaPorCliente</td>
                            <td>@orden.NombreEstado</td>
                            <td class="text-end">
                                @((orden.PrecioFinal ?? 0).ToString("C", new CultureInfo("es-AR")))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IEnumerable<OrdenListaDto>? ordenes;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ordenes = await ApiService.GetOrdenesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar órdenes: {ex.Message}");
            ordenes = Enumerable.Empty<OrdenListaDto>();
        }
    }
}