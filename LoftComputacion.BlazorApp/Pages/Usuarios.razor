@page "/usuarios"

@* --- Imports y Seguridad --- *@
@using LoftComputacion.BlazorApp.DTOs
@using LoftComputacion.BlazorApp.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject UsuarioApiService ApiService
@inject IJSRuntime JSRuntime

<PageTitle>Gestión de Usuarios</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Gestión de Usuarios</h1>

    @* Botón para abrir el Modal de Creación *@
    <button class="btn btn-primary" @onclick="AbrirModalCrear">
        <i class="bi bi-person-plus-fill"></i> Crear Nuevo Usuario
    </button>
</div>

@if (usuarios == null)
{
    <p><em>Cargando usuarios...</em></p>
}
else
{
    @* --- TABLA DE LISTADO DE USUARIOS --- *@
    <table class="table table-hover table-striped table-sm">
        <thead>
            <tr class="table-info">
                <th>ID</th>
                <th>Nombre Completo</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in usuarios)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.NombreCompleto</td>
                    <td>@user.Email</td>
                    <td>@user.Rol</td>
                    <td>
                        @if (user.EstaActivo)
                        {
                            <span class="badge text-bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-warning me-2" @onclick="() => AbrirModalEditar(user)">
                            <i class="bi bi-pencil-fill"></i> Editar
                        </button>
                        <button class="btn btn-sm @(user.EstaActivo ? "btn-outline-danger" : "btn-outline-success")"
                                @onclick="() => ToggleEstadoUsuario(user)">
                            <i class="bi bi-trash-fill"></i> @(user.EstaActivo ? "Desactivar" : "Activar")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* --- 2. MODAL DE CREACIÓN/EDICIÓN --- *@
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">

                @* Encabezado *@
                <div class="modal-header">
                    <h5 class="modal-title">@(usuarioActual.Id == 0 ? "Crear Nuevo Usuario" : $"Editar Usuario #{usuarioActual.Id}")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>

                @* Cuerpo del Formulario *@
                <EditForm Model="@usuarioActual" OnValidSubmit="GuardarUsuario">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label>Nombre Completo</label>
                                <InputText @bind-Value="usuarioActual.NombreCompleto" class="form-control" />
                                <ValidationMessage For="@(() => usuarioActual.NombreCompleto)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label>Email</label>
                                <InputText @bind-Value="usuarioActual.Email" class="form-control" />
                                <ValidationMessage For="@(() => usuarioActual.Email)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label>Rol</label>
                                <InputSelect @bind-Value="usuarioActual.Rol" class="form-select">
                                    <option value="">Seleccione un Rol</option>
                                    <option value="Administrador">Administrador</option>
                                    <option value="Tecnico">Técnico</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => usuarioActual.Rol)" />
                            </div>

                            @* El campo de contraseña solo es visible en Creación. En Edición, se maneja aparte. *@
                            @if (usuarioActual.Id == 0)
                            {
                                <div class="col-md-6 mb-3">
                                    <label>Contraseña</label>
                                    <InputText @bind-Value="((UsuarioCreacionDTO)usuarioActual).Password" type="password" class="form-control" />
                                    <ValidationMessage For="@(() => ((UsuarioCreacionDTO)usuarioActual).Password)" />
                                </div>
                            }

                            @* Mensaje de éxito o error *@
                            @if (!string.IsNullOrEmpty(mensajeFormulario))
                            {
                                <div class="alert @(esExito ? "alert-success" : "alert-danger") mt-3">
                                    @mensajeFormulario
                                </div>
                            }
                        </div>
                    </div>

                    @* Pie de página del Modal (Botones) *@
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save"></i> @(usuarioActual.Id == 0 ? "Crear Usuario" : "Guardar Cambios")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<UsuarioDTO>? usuarios;
    private UsuarioDTO usuarioActual = new UsuarioDTO(); // Usaremos DTO como base para la edición
    private bool mostrarModal = false;
    private string mensajeFormulario = string.Empty;
    private bool esExito = false;

    // --- 1. CARGA DE DATOS ---
    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        try
        {
            usuarios = await ApiService.GetUsuariosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar usuarios: {ex.Message}");
            // Manejo de errores más robusto si es necesario
        }
    }

    // --- 2. GESTIÓN DEL MODAL ---

    // Abrir para CREAR
    private void AbrirModalCrear()
    {
        // Creamos una nueva instancia de UsuarioCreacionDTO para incluir el campo Password
        usuarioActual = new UsuarioCreacionDTO();
        mensajeFormulario = string.Empty;
        mostrarModal = true;
    }

    // Abrir para EDITAR
    private void AbrirModalEditar(UsuarioDTO usuario)
    {
        // Clonamos el objeto para evitar modificar la lista directamente si se cancela
        usuarioActual = new UsuarioDTO
        {
            Id = usuario.Id,
            NombreCompleto = usuario.NombreCompleto,
            Email = usuario.Email,
            Rol = usuario.Rol,
            EstaActivo = usuario.EstaActivo
        };

        mensajeFormulario = string.Empty;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        // Limpiar el estado del formulario después de cerrar
        usuarioActual = new UsuarioDTO();
    }

    // --- 3. CRUD: GUARDAR (Crear o Editar) ---
    private async Task GuardarUsuario()
    {
        bool resultado = false;
        esExito = false;
        mensajeFormulario = string.Empty;

        try
        {
            if (usuarioActual.Id == 0)
            {
                // Es CREACIÓN (usa el DTO que tiene el campo Password)
                resultado = await ApiService.CrearUsuarioAsync((UsuarioCreacionDTO)usuarioActual);
            }
            else
            {
                // Es EDICIÓN
                resultado = await ApiService.ActualizarUsuarioAsync(usuarioActual.Id, usuarioActual);
            }

            if (resultado)
            {
                esExito = true;
                mensajeFormulario = "Usuario guardado exitosamente.";
                await CargarUsuarios(); // Recarga la tabla
                // Retraso para que el usuario vea el mensaje, luego cierra el modal
                await Task.Delay(1500);
                CerrarModal();
            }
            else
            {
                mensajeFormulario = "Error al guardar el usuario. Verifique los datos.";
            }
        }
        catch (Exception)
        {
            mensajeFormulario = "Ocurrió un error de conexión con la API.";
        }
    }

    // --- 4. CRUD: ELIMINAR/ACTIVAR/DESACTIVAR ---
    private async Task ToggleEstadoUsuario(UsuarioDTO user)
    {
        // Confirmación con JavaScript (requiere IJSRuntime injectado)
        string accion = user.EstaActivo ? "desactivar" : "activar";
        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Está seguro de que desea {accion} al usuario {user.NombreCompleto}?");

        if (confirmado)
        {
            // Nota: Este método asume que tu API usa DELETE para desactivar (ver UsuarioApiService)
            bool resultado = await ApiService.EliminarUsuarioAsync(user.Id);

            if (resultado)
            {
                // Si la desactivación fue exitosa, recargamos la lista
                await CargarUsuarios();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error al intentar {accion} al usuario.");
            }
        }
    }
}