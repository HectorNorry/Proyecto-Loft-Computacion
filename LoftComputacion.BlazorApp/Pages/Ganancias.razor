@page "/ganancias"
@using LoftComputacion.Domain
@using LoftComputacion.BlazorApp.Services
@using System.Globalization
@inject GananciasApiService GananciasApi

<PageTitle>Reporte de Ganancias</PageTitle>

<div class="container-fluid py-3">
    <h4 class="text-primary mb-4">Reporte de Ganancias</h4>

    <!-- Filtros de fechas -->
    <div class="card p-3 mb-4 shadow-sm">
        <div class="row g-3">
            <div class="col-12 col-md-5">
                <label for="fechaInicio" class="form-label">Desde:</label>
                <InputDate id="fechaInicio" class="form-control" @bind-Value="FechaInicio" />
            </div>
            <div class="col-12 col-md-5">
                <label for="fechaFin" class="form-label">Hasta:</label>
                <InputDate id="fechaFin" class="form-control" @bind-Value="FechaFin" />
            </div>
            <div class="col-12 col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" @onclick="ObtenerReporte" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span> Cargando...</span>
                    }
                    else
                    {
                        <span> Obtener Reporte</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- Resultados -->
    @if (ReporteOrdenes != null && ReporteOrdenes.Any())
    {
        <div class="alert alert-success mt-3">
            <h5 class="alert-heading">📈 Resumen de Ganancias (Netas)</h5>
            <p class="mb-0">
                <strong>Órdenes Pagadas:</strong> @ReporteOrdenes.Count() |
                <strong>Ingresos Totales (Netos):</strong>
                @IngresosTotales.ToString("C", new CultureInfo("es-AR"))
            </p>
        </div>

        <h5 class="mt-4">Detalle de Órdenes</h5>
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-success">
                    <tr>
                        <th>ID</th>
                        <th>Fecha Creada</th>
                        <th>Cliente</th>
                        <th>Descripción</th>
                        <th class="text-end">Precio Final</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var orden in ReporteOrdenes)
                    {
                        <tr>
                            <td>@orden.Id</td>
                            <td>@orden.FechaIngreso.ToShortDateString()</td>
                            <td>@(orden.Cliente?.NombreCompleto ?? "N/A")</td>
                            <td>@orden.FallaDeclaradaPorCliente</td>
                            <td class="text-end">
                                @((orden.PrecioFinal ?? 0).ToString("C", new CultureInfo("es-AR")))
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end fw-bold">TOTAL NETO</td>
                        <td class="text-end fw-bold">
                            @IngresosTotales.ToString("C", new CultureInfo("es-AR"))
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else if (!IsLoading && ReporteOrdenes != null)
    {
        <div class="alert alert-info mt-3">
            No se encontraron órdenes de servicio pagadas en el rango de fechas seleccionado.
        </div>
    }
    else if (IsLoading)
    {
        <div class="alert alert-warning mt-3">
            Cargando datos del reporte...
        </div>
    }
</div>

@code {
    private DateTime FechaInicio { get; set; } = DateTime.Now.AddDays(-30);
    private DateTime FechaFin { get; set; } = DateTime.Now.Date;

    private IEnumerable<OrdenDeServicio>? ReporteOrdenes;
    private bool IsLoading { get; set; } = false;
    private decimal IngresosTotales => ReporteOrdenes?.Sum(o => o.PrecioFinal) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await ObtenerReporte();
    }

    private async Task ObtenerReporte()
    {
        IsLoading = true;
        try
        {
            DateTime fechaFinAjustada = FechaFin.Date.AddDays(1).AddSeconds(-1);
            ReporteOrdenes = await GananciasApi.GetReporteAsync(FechaInicio.Date, fechaFinAjustada);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al obtener el reporte: {ex.Message}");
            ReporteOrdenes = null;
        }
        finally
        {
            IsLoading = false;
        }
    }
}