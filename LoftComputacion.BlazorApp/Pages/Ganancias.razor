@page "/ganancias"

@using MudBlazor
@using LoftComputacion.BlazorApp.Services.Ordenes

@inject OrdenesApiService OrdenesService

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h5" Class="mb-4">Ganancias</MudText>

    <!-- FILTROS DE FECHA -->
    <div class="d-flex gap-4 mb-4">
        <MudDatePicker Label="Desde"
                       @bind-Date="_desde"
                       MaxDate="_hasta" />

        <MudDatePicker Label="Hasta"
                       @bind-Date="_hasta"
                       MinDate="_desde" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Filtrar">
            Aplicar filtros
        </MudButton>
    </div>

    <!-- RESUMEN -->
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6">Resumen</MudText>

        <div class="mt-2">
            <MudText><b>Total facturado:</b> @_totalFacturado.ToString("C")</MudText>
        </div>

        <div>
            <MudText><b>Cantidad de órdenes:</b> @_ordenesFiltradas.Count</MudText>
        </div>

        <div>
            <MudText Color="Color.Success"><b>Ganancia neta:</b> @_totalFacturado.ToString("C")</MudText>
        </div>
    </MudPaper>

    <!-- TABLA DE ÓRDENES -->
    <MudTable Items="_ordenesFiltradas"
              Dense="true"
              Hover="true"
              Bordered="true"
              Elevation="1">

        <HeaderContent>
            <MudTh>Fecha</MudTh>
            <MudTh>Cliente</MudTh>
            <MudTh>Total</MudTh>
            <MudTh>Estado</MudTh>
        </HeaderContent>

        <RowTemplate>
            <!-- context es dynamic -->
            <MudTd>
                @{
                    DateTime fecha = DateTime.MinValue;
                    try { fecha = (DateTime)context.FechaIngreso; } catch { }
                }
                @fecha.ToShortDateString()
            </MudTd>

            <MudTd>@context.ClienteNombre</MudTd>
            <MudTd>@CalcularTotal(context).ToString("C")</MudTd>
            <MudTd>@context.EstadoActual</MudTd>
        </RowTemplate>

    </MudTable>

</MudPaper>

@code {
    // Listas dinámicas para no depender del tipo exacto del DTO
    private List<dynamic> _ordenes = new();
    private List<dynamic> _ordenesFiltradas = new();

    private DateTime? _desde = DateTime.Today.AddMonths(-1);
    private DateTime? _hasta = DateTime.Today;

    private decimal _totalFacturado = 0m;

    protected override async Task OnInitializedAsync()
    {
        // Usa el mismo servicio que ya tenés inyectado en otras vistas
        var data = await OrdenesService.GetTodasSimplesAsync();


        if (data != null)
        {
            // lo casteamos a dynamic para trabajar sin tipos fuertes
            _ordenes = data.Cast<dynamic>().ToList();
            Filtrar();
        }
    }

    private void Filtrar()
    {
        _ordenesFiltradas = _ordenes
            .Where(o =>
            {
                DateTime fecha;

                try { fecha = (DateTime)o.FechaIngreso; }
                catch { return false; }

                bool okDesde = !_desde.HasValue || fecha.Date >= _desde.Value.Date;
                bool okHasta = !_hasta.HasValue || fecha.Date <= _hasta.Value.Date;
                return okDesde && okHasta;
            })
            .OrderBy(o => (DateTime)o.FechaIngreso)
            .ToList();

        _totalFacturado = _ordenesFiltradas.Sum(o => CalcularTotal(o));
    }

    // Calcula el total usando PrecioFinal o PrecioPresupuestado si existen
    private decimal CalcularTotal(dynamic orden)
    {
        try
        {
            // si existe PrecioFinal y no es null
            if (HasProp(orden, "PrecioFinal") && orden.PrecioFinal != null)
                return (decimal)orden.PrecioFinal;
        }
        catch { }

        try
        {
            if (HasProp(orden, "PrecioPresupuestado") && orden.PrecioPresupuestado != null)
                return (decimal)orden.PrecioPresupuestado;
        }
        catch { }

        return 0m;
    }

    private bool HasProp(dynamic obj, string name)
    {
        return obj.GetType().GetProperty(name) != null;
    }
}
