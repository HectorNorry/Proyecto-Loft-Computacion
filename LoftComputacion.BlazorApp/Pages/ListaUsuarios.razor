@page "/usuarios-lista"
@using LoftComputacion.Shared.DTOs
@using LoftComputacion.BlazorApp.Services.Auth
@inject UsuariosApiService UsuariosService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using MudBlazor

<div class="pa-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5">Gestión de Usuarios</MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="NuevoUsuario" StartIcon="@Icons.Material.Filled.PersonAdd">
            Nuevo Usuario
        </MudButton>
    </div>

    @if (_cargando)
    {
        <div class="d-flex justify-center pa-12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else
    {
        <MudTable Items="_usuarios" Dense="true" Hover="true" Bordered="true" Filter="new Func<UsuarioDto, bool>(FilterFunc1)">
            <ToolBarContent>
                <MudSpacer />
                <MudTextField @bind-Value="_busqueda" Placeholder="Buscar..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mt-0" Immediate="true" />
            </ToolBarContent>

            <HeaderContent>
                <MudTh>Nombre</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Rol</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>@context.NombreCompleto</MudTd>
                <MudTd>@context.Email</MudTd>
                <MudTd>@context.Rol</MudTd>
                <MudTd>
                    <MudChip T="string"
                             Color="@(context.Activo ? Color.Success : Color.Error)"
                             Size="Size.Small"
                             Variant="Variant.Filled">
                        @(context.Activo ? "Operativo" : "De Baja")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Color="Color.Primary" Icon="@Icons.Material.Filled.Edit" OnClick="@(() => EditarUsuario(context))" />

                    @if (context.Activo)
                    {
                        <MudIconButton Color="Color.Error"
                                       Icon="@Icons.Material.Filled.PersonRemove"
                                       Title="Dar de baja"
                                       OnClick="@(() => CambiarEstado(context))" />
                    }
                    else
                    {
                        <MudIconButton Color="Color.Success"
                                       Icon="@Icons.Material.Filled.PersonAdd"
                                       Title="Reactivar"
                                       OnClick="@(() => CambiarEstado(context))" />
                    }
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudAlert Severity="Severity.Info">No se encontraron usuarios.</MudAlert>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager RowsPerPageString="Filas por página:"
                               InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudTable>
    }
</div>

@code {
    private List<UsuarioDto> _usuarios = new();
    private string _busqueda = "";
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        _cargando = true;
        try
        {
            var data = await UsuariosService.GetUsuarios();
            if (data != null) _usuarios = data;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error cargando usuarios: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private bool FilterFunc1(UsuarioDto element) =>
        string.IsNullOrWhiteSpace(_busqueda) ||
        $"{element.NombreCompleto} {element.Email} {element.Rol}".Contains(_busqueda, StringComparison.OrdinalIgnoreCase);

    private void NuevoUsuario() => AbrirDialogoUsuario(null);
    private void EditarUsuario(UsuarioDto usuario) => AbrirDialogoUsuario(usuario);

    private async Task CambiarEstado(UsuarioDto usuario)
    {
        string accion = usuario.Activo ? "dar de baja" : "reactivar";
        var confirm = await DialogService.ShowMessageBox(
            "Confirmar",
            $"¿Estás seguro que deseas {accion} a {usuario.NombreCompleto}?",
            yesText: "Confirmar",
            cancelText: "Cancelar");

        if (confirm != true) return;

        // Llamamos al método Eliminar de tu API (que ahora hará el Toggle en el backend)
        var resp = await UsuariosService.Eliminar(usuario.Id);

        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add($"Usuario {(usuario.Activo ? "desactivado" : "activado")} correctamente.", Severity.Success);
            await Cargar();
        }
        else
        {
            Snackbar.Add("Hubo un error al procesar la solicitud.", Severity.Error);
        }
    }

    private async void AbrirDialogoUsuario(UsuarioDto? usuario)
    {
        var parameters = new DialogParameters { ["Usuario"] = usuario };
        var dialog = DialogService.Show<DialogoUsuario>("Usuario", parameters);
        var result = await dialog.Result;
        if (!result.Canceled) await Cargar();
    }
}