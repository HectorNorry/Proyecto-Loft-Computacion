@using MudBlazor
@using LoftComputacion.Application.DTOs

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Editar cliente</MudText>
    </TitleContent>

    <DialogContent>
        <MudTextField @bind-Value="Cliente.NombreCompleto"
                      Label="Nombre completo"
                      Required="true"
                      Class="mb-3" />

        <MudTextField @bind-Value="Cliente.Telefono"
                      Label="Teléfono"
                      Required="true"
                      Class="mb-3" />

        <MudTextField @bind-Value="Cliente.Email"
                      Label="Email"
                      Class="mb-3" />

        <MudTextField @bind-Value="Cliente.DNI"
                      Label="DNI"
                      Class="mb-3" />
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Guardar">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public ClienteEditarDto Cliente { get; set; } = default!;

    private void Guardar()
    {
        MudDialog.Close(DialogResult.Ok(Cliente));
    }

    private void Cancelar()
    {
        MudDialog.Cancel();
    }
}
