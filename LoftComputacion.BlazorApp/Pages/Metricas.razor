@page "/metricas"
@using MudBlazor
@using LoftComputacion.Shared.DTOs
@using LoftComputacion.BlazorApp.Services.Ordenes
@inject OrdenesApiService OrdenesService

<style>
    .metricas-card {
        width: 100%;
        max-width: 600px;
        margin: 0 auto 16px;
    }

    .chart-responsive {
        width: 100% !important;
        height: auto !important;
    }

    @@media (max-width: 600px) {
        /* Limitamos un poco la altura en móviles para que entren los dos Donuts sin scrollear tanto */
        .chart-responsive {
            max-height: 280px;
        }

        .metricas-card {
            margin-bottom: 12px;
            padding: 8px !important;
        }
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <MudText Typo="Typo.h4" Class="mb-4 fw-bold">
        Métricas Operativas (Últimos 30 días)
    </MudText>

    @if (_metricas == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-theme-primary metricas-card" Elevation="3">
                    <MudText Typo="Typo.h3">@_metricas.TotalOrdenesMes</MudText>
                    <MudText Typo="Typo.subtitle1">Equipos Ingresados</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4 d-flex flex-column align-center justify-center metricas-card"
                          Style="background-color: #4caf50; color: white;" Elevation="3">
                    <MudText Typo="Typo.h3">@_metricas.CantidadFinalizadas</MudText>
                    <MudText Typo="Typo.subtitle1">Reparaciones Exitosas</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4 d-flex flex-column align-center justify-center metricas-card"
                          Style="background-color: #ff9800; color: white;" Elevation="3">
                    <MudText Typo="Typo.h3">@_metricas.TasaRebote%</MudText>
                    <MudText Typo="Typo.subtitle1">Tasa de Rechazo</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 d-flex flex-column align-center metricas-card" Elevation="2" Style="height: 100%;">
                    <MudText Typo="Typo.h6" Class="mb-4 align-self-start">Tipos de Equipos</MudText>
                    @if (_dataHardware.Length > 0)
                    {
                        <MudChart ChartType="ChartType.Donut"
                                  Class="chart-responsive"
                                  InputData="@_dataHardware"
                                  InputLabels="@_labelsHardware"
                                  LegendPosition="Position.Bottom"
                                  ChartOptions="@(new ChartOptions { ChartPalette = new[] { "#2196F3", "#00C853", "#FFC107" } })">
                        </MudChart>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 d-flex flex-column align-center metricas-card" Elevation="2" Style="height: 100%;">
                    <MudText Typo="Typo.h6" Class="mb-4 align-self-start">Reparaciones por Técnico</MudText>
                    @if (_dataTecnicos.Length > 0)
                    {
                        <MudChart ChartType="ChartType.Donut"
                                  Class="chart-responsive"
                                  InputData="@_dataTecnicos"
                                  InputLabels="@_labelsTecnicosDonut"
                                  LegendPosition="Position.Bottom"
                                  ChartOptions="@(new ChartOptions { ChartPalette = new[] { "#594AE2", "#EC407A", "#00B8D4" } })">
                        </MudChart>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private MetricasDto? _metricas;

    // Arrays para Equipos
    private double[] _dataHardware = Array.Empty<double>();
    private string[] _labelsHardware = Array.Empty<string>();

    // Arrays para Técnicos (Donut usa arrays, no List<ChartSeries>)
    private double[] _dataTecnicos = Array.Empty<double>();
    private string[] _labelsTecnicosDonut = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        _metricas = await OrdenesService.GetMetricasAsync();

        if (_metricas != null)
        {
            // 1. PROCESAR EQUIPOS
            _dataHardware = _metricas.OrdenesPorTipo.Select(x => x.Valor).ToArray();
            double totalH = _dataHardware.Sum();
            _labelsHardware = _metricas.OrdenesPorTipo.Select(x =>
            {
                double pct = totalH > 0 ? (x.Valor / totalH * 100) : 0;
                return $"{x.Etiqueta.Replace("_", " ")} ({pct:0.0}%)";
            }).ToArray();

            // 2. PROCESAR TÉCNICOS (Para el nuevo Donut)
            _dataTecnicos = _metricas.RendimientoTecnicos.Select(x => x.Valor).ToArray();
            double totalT = _dataTecnicos.Sum();
            _labelsTecnicosDonut = _metricas.RendimientoTecnicos.Select(x =>
            {
                // Solo el primer nombre para que no sea un texto gigante
                string primerNombre = x.Etiqueta.Split(' ')[0];
                double pct = totalT > 0 ? (x.Valor / totalT * 100) : 0;
                return $"{primerNombre} ({pct:0.0}%)";
            }).ToArray();
        }
    }
}