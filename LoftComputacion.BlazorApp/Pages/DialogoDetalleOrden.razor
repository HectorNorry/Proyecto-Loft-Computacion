@using MudBlazor
@using LoftComputacion.Shared.DTOs

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2 mb-n1" />
            Detalle de la Orden #@Orden.Id
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Style="max-height: 60vh; overflow-y: scroll;">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Cliente</MudText>
            <MudText Typo="Typo.body1" Class="mb-3 fw-bold">@Orden.ClienteNombre</MudText>

            <MudGrid Class="mb-2">
                <MudItem xs="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Tipo de equipo</MudText>
                    <MudText Typo="Typo.body1">@Orden.EquipoTipo</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Modelo</MudText>
                    <MudText Typo="Typo.body1">@Orden.EquipoModelo</MudText>
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Falla declarada</MudText>
            <MudText Typo="Typo.body1" Class="mb-3">@Orden.FallaDeclarada</MudText>

            @if (!string.IsNullOrWhiteSpace(Orden.ResumenTecnico))
            {
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Resumen técnico</MudText>
                <MudText Typo="Typo.body1" Class="mb-3 italic">@Orden.ResumenTecnico</MudText>
            }

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Historial de estados</MudText>
            @if (Orden.Historial?.Any() == true)
            {
                <MudTimeline TimelinePosition="TimelinePosition.Start" Modifiers="true">
                    @foreach (var h in Orden.Historial)
                    {
                        <MudTimelineItem Color="Color.Info" Size="Size.Small">
                            <ItemContent>
                                <MudPaper Elevation="0" Class="pa-2" Style="background-color: var(--mud-palette-background-grey);">
                                    <MudText Typo="Typo.caption" Class="fw-bold">
                                        @h.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                    </MudText>
                                    <MudText Typo="Typo.body2">@h.Descripcion</MudText>
                                </MudPaper>
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            }
            else
            {
                <MudText Typo="Typo.body2" Align="Align.Center">No hay registros de historial.</MudText>
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Cerrar">Entendido</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public OrdenDetalleDto Orden { get; set; } = null!;

    private void Cerrar() => MudDialog.Close(DialogResult.Ok(true));
}