@page "/ordenes/editar/{id:int}"

@using System.Net.Http
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using LoftComputacion.Shared.DTOs;
@using LoftComputacion.BlazorApp.Services.Ordenes
@using LoftComputacion.BlazorApp.Services.Auth

@inject OrdenesApiService OrdenesService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject CustomAuthStateProvider AuthProvider
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.False" Class="mt-6">

    @if (Cargando)
    {
        <div class="d-flex justify-center mt-6">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (Orden is null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">
            No se encontró la orden.
        </MudAlert>
    }
    else
    {
        <MudGrid GutterSize="3">
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h5" Class="mb-3 fw-bold">
                        Editar Orden #@Orden.Id
                    </MudText>
                    <MudText Typo="Typo.subtitle2"><b>Cliente:</b> @Orden.ClienteNombre (@Orden.EmailCliente)</MudText>
                    <MudText Typo="Typo.subtitle2"><b>Fecha ingreso:</b> @Orden.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</MudText>
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2"><b>Estado actual:</b> @Orden.Estado</MudText>
                    <MudText Typo="Typo.subtitle2"><b>Equipo:</b> @Orden.EquipoTipo @Orden.EquipoModelo</MudText>

                    @if (!string.IsNullOrWhiteSpace(Orden.EquipoDescripcion))
                    {
                        <MudText Typo="Typo.subtitle2"><b>Descripción equipo:</b> @Orden.EquipoDescripcion</MudText>
                    }
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2"><b>Falla declarada:</b> @Orden.FallaDeclarada</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Cambiar estado</MudText>
                    <MudSelect T="int" Label="Estado" @bind-Value="EstadoId" Required="true">
                        @foreach (var e in Estados)
                        {
                            <MudSelectItem Value="@e.Id">@e.Nombre</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField T="decimal?" Label="Precio presupuestado" @bind-Value="PrecioPresupuestado" Class="mt-3" />
                    <MudNumericField T="decimal?" Label="Precio final" @bind-Value="PrecioFinal" Class="mt-3" />
                    <MudTextField Label="Resumen técnico" Lines="4" TextFieldStyle="TextFieldStyle.Filled" @bind-Value="ResumenTecnico" Class="mt-3" />

                    <MudStack Row="true" Spacing="2" Class="mt-4">
                        @if (Orden.Estado == "Finalizado, a espera de pago" && Orden.PrecioFinal > 0)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="GenerarLinkPago" StartIcon="@Icons.Material.Filled.Payment" Disabled="@Guardando">
                                Generar Link MP
                            </MudButton>
                        }

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarCambios" Disabled="@Guardando">
                            @if (Guardando)
                            {
                                <MudProgressCircular Indeterminate="true" Size="@Size.Small" />
                            }
                            else
                            {
                                <span>Guardar cambios</span>
                            }
                        </MudButton>

                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => Nav.NavigateTo("/ordenes"))">
                            Cancelar
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Historial</MudText>
                    @if (Orden.Historial is null || Orden.Historial.Count == 0)
                    {
                        <MudText Color="Color.Secondary">Esta orden no tiene historial.</MudText>
                    }
                    else
                    {
                        <MudList T="HistorialLineaDto" Dense="true">
                            @foreach (var h in Orden.Historial)
                            {
                                <MudListItem T="HistorialLineaDto">
                                    <MudListItemText>
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                                            @h.FechaHora.ToLocalTime().ToString("g")
                                        </MudText>
                                        <div style="margin-top: 2px;">@h.Descripcion</div>
                                    </MudListItemText>
                                </MudListItem>
                                <MudDivider />
                            }
                        </MudList>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-4 mt-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Fotos del equipo</MudText>
                    <div style="display:flex; gap:16px; flex-wrap:wrap;">
                        @if (Orden.Fotos is not null)
                        {
                            @foreach (var foto in Orden.Fotos)
                            {
                                <div style="position:relative; width:120px; height:120px; border-radius:6px; overflow:hidden; border: 1px solid #ddd;">
                                    <img src="@foto.Url" style="width:100%; height:100%; object-fit:cover;" />
                                    
                                    <div style="position:absolute; top:4px; right:4px; z-index:20;" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Style="background:white;" 
                                                       OnClick="@(() => EliminarFoto(foto))" />
                                    </div>

                                    <div style="position:absolute; bottom:4px; right:4px; z-index:20;" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.ZoomIn" Color="Color.Primary" Size="Size.Small" Style="background:white;" 
                                                       OnClick="@(() => VerFoto(foto.Url))" />
                                    </div>
                                </div>
                            }
                        }

                        <label style="width:120px; height:120px; border:2px dashed #bbb; display:flex; justify-content:center; align-items:center; cursor:pointer; border-radius:6px; position:relative;">
                            <InputFile OnChange="SubirFoto" accept="image/*" style="opacity:0; width:100%; height:100%; position:absolute; left:0; top:0; cursor:pointer;" />
                            <div style="text-align:center;">
                                <MudIcon Icon="@Icons.Material.Filled.AddAPhoto" />
                                <div style="font-size:12px;">Agregar foto</div>
                            </div>
                        </label>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

</MudContainer>

@code {
    [Parameter] public int id { get; set; }
    private OrdenDetalleDto? Orden;
    private bool Cargando = true;
    private bool Guardando = false;
    private int EstadoId;
    private decimal? PrecioPresupuestado;
    private decimal? PrecioFinal;
    private string? ResumenTecnico;
    private int _estadoIdOriginal;

    private readonly List<(int Id, string Nombre)> Estados = new()
    {
        (1, "Recibido"), (2, "Esperando Aprobación"), (3, "En Proceso"),
        (4, "Finalizado, a espera de pago"), (5, "Entregado"), (6, "Cancelado"), (7, "Pagado")
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Orden = await OrdenesService.GetDetalleAsync(id);
            if (Orden != null)
            {
                EstadoId = EstadoNombreToId(Orden.Estado);
                PrecioPresupuestado = Orden.PrecioPresupuestado;
                PrecioFinal = Orden.PrecioFinal;
                ResumenTecnico = Orden.ResumenTecnico;
                _estadoIdOriginal = EstadoId;
                Orden.Fotos ??= new List<FotoDto>();
                Orden.Historial ??= new List<HistorialLineaDto>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar la orden: {ex.Message}", Severity.Error);
        }
        finally
        {
            Cargando = false;
        }
    }

    private int EstadoNombreToId(string nombre)
    {
        var match = Estados.FirstOrDefault(e => e.Nombre == nombre);
        return match.Id == 0 ? 1 : match.Id;
    }

    private async Task GuardarCambios()
    {
        Guardando = true;
        string? usuarioAutorizador = null;
        try
        {
            if (EstadoId != _estadoIdOriginal)
            {
                var options = new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false };
                var dialog = DialogService.Show<DialogoConfirmarCredenciales>("Confirmar Cambio de Estado", options);
                var result = await dialog.Result;
                if (result.Canceled) { Guardando = false; return; }
                usuarioAutorizador = result.Data.ToString();
            }

            var usuarioIdLogueado = await AuthProvider.GetUserIdAsync();
            var dto = new UpdateOrdenDto
            {
                EstadoId = EstadoId,
                PrecioPresupuestado = PrecioPresupuestado,
                PrecioFinal = PrecioFinal,
                ResumenTecnico = ResumenTecnico,
                UsuarioId = usuarioIdLogueado,
                UsuarioAutorizador = usuarioAutorizador
            };

            var response = await Http.PutAsJsonAsync($"api/OrdenesDeServicio/{id}", dto);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al guardar cambios: {body}", Severity.Error);
                return;
            }

            Snackbar.Add("Cambios guardados correctamente.", Severity.Success);
            _estadoIdOriginal = EstadoId;
            Nav.NavigateTo("/ordenes");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error crítico: {ex.Message}", Severity.Error);
        }
        finally
        {
            Guardando = false;
        }
    }

    // --- AQUÍ ESTABA EL PROBLEMA, AHORA USAMOS EL SERVICIO ---
    private async Task SubirFoto(InputFileChangeEventArgs e)
    {
        if (Orden is null) return;
        var file = e.File;
        if (file is null || file.Size == 0) { Snackbar.Add("No se seleccionó archivo.", Severity.Warning); return; }

        try
        {
            // Usamos el servicio que tiene la lógica del Token
            var nuevaFotoDto = await OrdenesService.SubirFotoAsync(id, file);

            // Actualizamos la lista visualmente
            Orden.Fotos.Add(nuevaFotoDto);
            Snackbar.Add("Foto subida correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al subir la foto: {ex.Message}", Severity.Error);
        }
    }

    // --- AQUÍ TAMBIÉN USAMOS EL SERVICIO AHORA ---
    private async Task EliminarFoto(FotoDto foto)
    {
        bool? confirmar = await DialogService.ShowMessageBox("Eliminar foto", "¿Seguro que querés eliminar esta foto?", yesText: "Eliminar", cancelText: "Cancelar");
        if (confirmar != true) return;

        try
        {
            // Usamos el servicio para borrar con Token
            await OrdenesService.BorrarFotoAsync(foto.Id);

            Orden.Fotos.Remove(foto);
            Snackbar.Add("Foto eliminada.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar foto: {ex.Message}", Severity.Error);
        }
    }

    private void VerFoto(string url)
    {
        var parameters = new DialogParameters { ["Url"] = url };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        DialogService.Show<DialogoFoto>("Foto del equipo", parameters, options);
    }

    private async Task GenerarLinkPago()
    {
        if (Orden is null || Orden.PrecioFinal <= 0) { Snackbar.Add("Debe definir un precio final válido.", Severity.Warning); return; }
        Guardando = true;
        try
        {
            string? url = await OrdenesService.GenerarLinkDePagoAsync(id);
            if (string.IsNullOrWhiteSpace(url)) { Snackbar.Add("La API no devolvió un link válido.", Severity.Error); return; }
            var parameters = new DialogParameters { ["Url"] = url, ["Monto"] = (Orden.PrecioFinal ?? 0).ToString("C"), ["OrdenId"] = Orden.Id };
            DialogService.Show<DialogoLinkPago>("Link de Pago Generado", parameters);
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { Guardando = false; }
    }
}